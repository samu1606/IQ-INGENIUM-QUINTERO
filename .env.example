# Nombres de las variables que lee la landing. Esto es la plantilla: vive en el
# repo y NO lleva valores reales. Los valores van en el `.env` del servidor
# (VPS), que nunca se commitea.
#
# Se copian a mano en el compose/VPS. Nada de aquí es obligatorio: sin
# variables, la página funciona igual — sin analítica, sin demo y con el
# dominio de respaldo.

# ---------------------------------------------------------------- sitio
# Sale en canonical, og:url, og:image, sitemap y JSON-LD. Si está mal, los
# enlaces compartidos por WhatsApp salen sin previsualización.
# SE INCRUSTA AL CONSTRUIR: cambiarla exige reconstruir la imagen.
NEXT_PUBLIC_SITE_URL=https://ingeniumquintero.com

# ------------------------------------------------------------ analítica
# Umami auto-hospedado. Con las dos vacías no se carga ningún script.
# También se incrustan al construir.
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_ID=

# ----------------------------------------------------------------- leads
# Dónde queda cada lead del formulario (una línea JSON). En Docker hay que
# montar un volumen en esa carpeta o el `up --build` se los lleva.
LEAD_STORE_PATH=/app/data/leads.jsonl
# POST opcional con el lead (n8n, Google Sheet, correo…). Si falla, el lead
# igual queda en el archivo y el visitante no ve un error.
LEAD_WEBHOOK_URL=

# ------------------------------------------------------- demo en vivo
# Cualquier endpoint compatible con OpenAI (`/chat/completions`):
#   Ollama en el propio VPS .... http://localhost:11434/v1
#   vLLM ....................... http://127.0.0.1:8000/v1
#   Proveedor con clave ....... https://api.proveedor.com/v1  (+ la clave)
# Sin BASE_URL o sin MODEL, la demo se declara apagada y manda a WhatsApp.
# Estas SÍ se leen en tiempo de ejecución: no hace falta reconstruir.
DEMO_LLM_BASE_URL=
DEMO_LLM_MODEL=
DEMO_LLM_API_KEY=
